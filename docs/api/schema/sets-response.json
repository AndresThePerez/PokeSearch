{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GET /api/v1/sets 200",
  "description": "Every set the index holds, ordered by release_date ascending and then id ascending.",
  "type": "object",
  "additionalProperties": false,
  "required": ["data", "seed"],
  "properties": {
    "data": { "type": "array", "items": { "$ref": "#/$defs/set" } },
    "seed": { "$ref": "card-response.json#/$defs/seed" }
  },
  "$defs": {
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "series", "total", "release_date", "card_count"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "series": { "type": "string" },
        "total": { "description": "The set's printed size.", "type": "integer", "minimum": 0 },
        "release_date": { "description": "yyyy-MM-dd.", "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "card_count": { "description": "How many of the set's cards the index holds; it can differ from total (secret rares, cards the dataset lacks).", "type": "integer", "minimum": 1 }
      }
    }
  }
}
